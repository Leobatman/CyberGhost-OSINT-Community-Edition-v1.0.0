# =============================================================================
# CyberGhost OSINT Enterprise — Environment Variables
# NUNCA commite este arquivo com valores reais!
# Copie para .env e preencha com seus valores
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="CyberGhost OSINT Enterprise"
APP_VERSION="8.0.0"
APP_ENV="development"  # development | staging | production
DEBUG=false
SECRET_KEY="CHANGE_THIS_TO_A_64_CHAR_RANDOM_STRING"
ALLOWED_HOSTS="localhost,127.0.0.1"
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET_KEY="CHANGE_THIS_TO_A_DIFFERENT_64_CHAR_RANDOM_STRING"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://cyberghost:CHANGE_PASSWORD@localhost:5432/cyberghost"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://:CHANGE_PASSWORD@localhost:6379/0"
REDIS_CACHE_TTL=3600

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL="redis://:CHANGE_PASSWORD@localhost:6379/1"
CELERY_RESULT_BACKEND="redis://:CHANGE_PASSWORD@localhost:6379/2"
CELERY_MAX_WORKERS=10

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_URL="https://localhost:9200"
ELASTICSEARCH_USERNAME="elastic"
ELASTICSEARCH_PASSWORD="CHANGE_PASSWORD"
ELASTICSEARCH_CA_CERT="/certs/ca.crt"

# ── Neo4j (Knowledge Graph) ───────────────────────────────────────────────────
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="CHANGE_PASSWORD"
NEO4J_DATABASE="cyberghost"

# ── Qdrant (Vector DB for AI/RAG) ─────────────────────────────────────────────
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="CHANGE_THIS"
QDRANT_COLLECTION="cyberghost_knowledge"

# ── AI / LLM ─────────────────────────────────────────────────────────────────
AI_PROVIDER="ollama"  # ollama | openai | anthropic | auto
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
EMBEDDING_MODEL="nomic-embed-text"

# ── OSINT API Keys ────────────────────────────────────────────────────────────
SHODAN_API_KEY=""
VIRUSTOTAL_API_KEY=""
CENSYS_API_ID=""
CENSYS_API_SECRET=""
GREYNOISE_API_KEY=""
HUNTER_API_KEY=""
SECURITYTRAILS_API_KEY=""
ZOOMEYE_API_KEY=""
BINARYEDGE_API_KEY=""
HIBP_API_KEY=""
EMAILREP_API_KEY=""
GITHUB_API_KEY=""
ABUSEIPDB_API_KEY=""
ALIENVAULT_OTX_API_KEY=""
IBM_XFORCE_API_KEY=""
IBM_XFORCE_API_PASSWORD=""

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_SERVICE_NAME="cyberghost-backend"
OTEL_ENVIRONMENT="development"
LOG_LEVEL="INFO"
LOG_FORMAT="json"  # json | console

# ── Storage ───────────────────────────────────────────────────────────────────
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="CHANGE_THIS"
MINIO_SECRET_KEY="CHANGE_THIS"
MINIO_BUCKET="cyberghost-reports"
MINIO_SECURE=false

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ── HashiCorp Vault (produção) ────────────────────────────────────────────────
VAULT_ADDR=""
VAULT_TOKEN=""
VAULT_PATH="secret/cyberghost"